# ==============================================
# Chronos Logística — Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env

# ----------------------------------------------
# DESENVOLVIMENTO LOCAL
# ----------------------------------------------

# URL da API local (Express rodando em dev)
VITE_API_URL=http://localhost:3000/api

# ----------------------------------------------
# Supabase — Backend (Node.js / server-side)
# NÃO expor ao browser. Sem prefixo VITE_.
# ----------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# ----------------------------------------------
# Supabase — Frontend (Vite / browser-side)
# Prefixo VITE_ é obrigatório para o Vite expor ao browser.
# ----------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ----------------------------------------------
# PRODUÇÃO — Vercel (Frontend)
# Configurar no painel do Vercel:
#   VITE_API_URL = https://chronos-logistica-api.onrender.com/api
#   VITE_SUPABASE_URL = https://SEU-PROJETO.supabase.co
#   VITE_SUPABASE_ANON_KEY = sua-anon-key
# ----------------------------------------------

# ----------------------------------------------
# PRODUÇÃO — Render (Backend)
# Configurar no painel do Render (Environment):
#   NODE_ENV = production
#   SUPABASE_URL = https://SEU-PROJETO.supabase.co
#   SUPABASE_ANON_KEY = sua-anon-key
#   FRONTEND_URL = https://seu-app.vercel.app
# ----------------------------------------------
